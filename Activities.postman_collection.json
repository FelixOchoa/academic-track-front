{
  "info": {
    "name": "AcademicTrack - Activities",
    "description": "Endpoints del módulo de registro de actividades y evidencias (ActivitiesController). Base URL configurable por variable de colección {{baseUrl}} (por defecto apunta al perfil http de launchSettings.json: http://localhost:5282).\n\nFlujo sugerido: correr 'Create Activity' primero (guarda el id creado en {{activityId}} automáticamente), luego el resto de requests en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5282", "type": "string" },
    { "key": "activityId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Create Activity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has an id and Location header', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.be.a('number');",
              "    pm.expect(pm.response.headers.has('Location')).to.be.true;",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('activityId', jsonData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"programId\": 1,\n  \"type\": 4,\n  \"name\": \"AI Hackathon 2026\",\n  \"date\": \"2026-09-15\",\n  \"location\": \"Auditorio Principal\",\n  \"responsible\": \"Ana Vega\",\n  \"participatingProfessors\": [\"Juan Pérez\", \"María Gómez\"],\n  \"participatingStudents\": [\"Carlos Ruiz\", \"Laura Torres\"],\n  \"description\": \"Hackathon de 48 horas enfocado en soluciones de IA para la universidad.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/activities",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities" ]
        },
        "description": "Crea una actividad. 'type' es el enum ActivityType como número: 1=ClassroomProject, 2=ResearchProject, 3=ScientificArticle, 4=Hackathon (System.Text.Json serializa enums como número por defecto en este proyecto)."
      }
    },
    {
      "name": "Get All Activities",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/activities",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities" ]
        },
        "description": "Lista todas las actividades, sin filtros."
      }
    },
    {
      "name": "Get Activities Filtered (programId + type)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/activities?programId=1&type=Hackathon",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities" ],
          "query": [
            { "key": "programId", "value": "1" },
            { "key": "type", "value": "Hackathon" }
          ]
        },
        "description": "Filtra por programa y tipo. Para query string, el enum también acepta el nombre (Hackathon) además del número (4)."
      }
    },
    {
      "name": "Get Activity By Id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returned id matches requested id', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(String(jsonData.id)).to.eql(pm.collectionVariables.get('activityId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/activities/{{activityId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities", "{{activityId}}" ]
        },
        "description": "Requiere haber corrido 'Create Activity' antes para que {{activityId}} tenga valor."
      }
    },
    {
      "name": "Get Activity By Id - Not Found",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/activities/999999",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities", "999999" ]
        },
        "description": "Id que no existe: debe responder 404."
      }
    },
    {
      "name": "Update Activity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Name was updated', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql('AI Hackathon 2026 - Updated');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"AI Hackathon 2026 - Updated\",\n  \"date\": \"2026-09-16\",\n  \"location\": \"Auditorio Principal - Bloque B\",\n  \"responsible\": \"Ana Vega\",\n  \"participatingProfessors\": [\"Juan Pérez\"],\n  \"participatingStudents\": [\"Carlos Ruiz\", \"Laura Torres\", \"Pedro Sánchez\"],\n  \"description\": \"Descripción actualizada tras el reagendamiento.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/activities/{{activityId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities", "{{activityId}}" ]
        },
        "description": "Actualiza la actividad. No incluye programId ni type: son inmutables tras la creación."
      }
    },
    {
      "name": "Add Evidence",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Evidence list is not empty', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.evidences.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Certificado de participación del hackathon\",\n  \"url\": \"https://drive.google.com/drive/folders/example\",\n  \"uploadDate\": \"2026-09-17\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/activities/{{activityId}}/evidences",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities", "{{activityId}}", "evidences" ]
        },
        "description": "Agrega una evidencia a la actividad. 'uploadDate' es opcional: si se omite, el backend usa la fecha actual."
      }
    },
    {
      "name": "Delete Activity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/activities/{{activityId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities", "{{activityId}}" ]
        },
        "description": "Elimina físicamente la actividad creada. Corre esto al final del flujo."
      }
    },
    {
      "name": "Verify Deletion (expect 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404 after deletion', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/activities/{{activityId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "activities", "{{activityId}}" ]
        },
        "description": "Confirma que la actividad ya no existe tras el DELETE."
      }
    }
  ]
}
